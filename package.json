{
  "name": "tutti-music",
  "version": "2.3.0",
  "description": "Tutti \u2014 a symphonic tracker: compose orchestral music in a tracker-style grid and export to MIDI. Single-file browser app with no dependencies.",
  "homepage": "https://ajturner.github.io/tutti-music/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajturner/tutti-music.git"
  },
  "bugs": {
    "url": "https://github.com/ajturner/tutti-music/issues"
  },
  "author": "Andrew Turner <ajturner@highearthorbit.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "music",
    "tracker",
    "midi",
    "orchestra",
    "symphonic",
    "sequencer",
    "web-audio"
  ],
  "scripts": {
    "start": "npx --yes serve -l 3000 .",
    "dev": "npx --yes serve -l 3000 .",
    "test": "npm run test:core && npm run test:schema && npm run test:ui",
    "test:core": "node test/core.test.mjs",
    "test:schema": "node test/schema.test.mjs",
    "test:ui": "mkdir -p test/out && node test/ui.test.mjs",
    "build:samples": "node scripts/build-samples.mjs"
  },
  "files": [
    "index.html",
    "help.html",
    "styles.css",
    "src",
    "schema",
    "samples"
  ],
  "devDependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.49.1"
  }
}
